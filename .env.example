# ============================================================
# TotemFood — Variáveis de ambiente (exemplo)
# ------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha os valores.
# Enquanto essas variáveis não existirem, a aplicação usa a
# camada MockService automaticamente (veja src/services).
# ============================================================

# Fonte de dados: "mock" (padrão) ou "supabase"
VITE_DATA_SOURCE=mock

# Supabase (usado somente quando VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Empresa padrão carregada no totem (multiempresa)
VITE_DEFAULT_COMPANY_ID=company-001